---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
---
<header class="fixed top-0 inset-x-0 z-50 transition-smooth bg-card/90 backdrop-blur-md border-b border-border/50">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-16 flex items-center justify-between">
    <a href="/jemin_prism/" class="transition-smooth hover:opacity-80">
      <Image src={logoImg} alt="Prism Packworld" class="h-10 w-auto" height={40} />
    </a>
    
    <nav class="hidden md:flex items-center gap-1">
      <a href="/jemin_prism/#products" class="px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md hover:bg-muted/60">
        Products
      </a>
      <a href="/jemin_prism/#about" class="px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md hover:bg-muted/60">
        About
      </a>
      <a href="/jemin_prism/contact" class="px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md hover:bg-muted/60">
        Contact
      </a>
      <a href="/jemin_prism/contact" class="ml-3">
        <button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-display font-semibold tracking-wide h-8 rounded-md px-4 bg-foreground text-background hover:bg-accent hover:text-foreground transition-smooth">
          Get a Quote
        </button>
      </a>
    </nav>

    <button type="button" id="menu-toggle" class="md:hidden p-2 rounded-md text-foreground hover:bg-muted/60 transition-colors" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu" aria-hidden="true">
        <path d="M4 12h16"></path>
        <path d="M4 18h16"></path>
        <path d="M4 6h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-16 inset-x-0 bg-card border-b border-border shadow-elevated p-6 animate-in slide-in-from-top duration-300">
    <nav class="flex flex-col gap-4">
      <a href="/jemin_prism/#products" class="text-lg font-display font-semibold text-foreground hover:text-accent transition-colors">Products</a>
      <a href="/jemin_prism/#about" class="text-lg font-display font-semibold text-foreground hover:text-accent transition-colors">About</a>
      <a href="/jemin_prism/contact" class="text-lg font-display font-semibold text-foreground hover:text-accent transition-colors">Contact</a>
      <hr class="border-border/50 my-2" />
      <a href="/jemin_prism/contact">
        <button class="w-full h-12 rounded-xl bg-foreground text-background font-display font-bold text-base hover:bg-accent hover:text-foreground transition-smooth">
          Get a Quote
        </button>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isOpen = !menu.classList.contains('hidden');
      toggle.innerHTML = isOpen 
        ? `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu" aria-hidden="true"><path d="M4 12h16"></path><path d="M4 18h16"></path><path d="M4 6h16"></path></svg>`;
    });

    // Close menu on link click
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu" aria-hidden="true"><path d="M4 12h16"></path><path d="M4 18h16"></path><path d="M4 6h16"></path></svg>`;
      });
    });
  }
</script>
