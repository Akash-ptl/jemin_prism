---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
---
<footer class="bg-card border-t border-border mt-auto">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="flex flex-col gap-4">
      <a href="/" class="transition-smooth hover:opacity-80">
        <Image src={logoImg} alt="Prism Packworld" class="h-10 w-auto" height={40} />
      </a>
      <p class="text-sm text-muted-foreground leading-relaxed max-w-xs">
        Premium packaging solutions crafted for brands that refuse to compromise on quality and presentation.
      </p>
      <div class="flex items-center gap-3 mt-2">
        <a href="#" aria-label="Instagram" class="w-9 h-9 rounded-lg bg-muted/60 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted transition-smooth">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a href="https://wa.me/919909927668" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-9 h-9 rounded-lg bg-muted/60 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted transition-smooth">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path></svg>
        </a>
        <a href="#" aria-label="Facebook" class="w-9 h-9 rounded-lg bg-muted/60 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted transition-smooth">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="#" aria-label="Twitter" class="w-9 h-9 rounded-lg bg-muted/60 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted transition-smooth">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h4 class="font-display font-semibold text-sm tracking-widest uppercase text-foreground mb-5">Products</h4>
      <ul class="flex flex-col gap-2.5">
        <li><a href="/products/rigid-box" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Rigid Boxes</a></li>
        <li><a href="/products/corrugated-box" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Corrugated Boxes</a></li>
        <li><a href="/products/mono-carton" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Mono Cartons</a></li>
        <li><a href="/products/paper-tube" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Paper Tubes</a></li>
        <li><a href="/products/paper-bag" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Paper Bags</a></li>
        <li><a href="/products/tags" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Tags & Labels</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-display font-semibold text-sm tracking-widest uppercase text-foreground mb-5">Contact</h4>
      <address class="not-italic flex flex-col gap-3 text-sm text-muted-foreground">
        <a href="tel:+919909927668" class="hover:text-foreground transition-colors">+91 99099 27668</a>
        <a href="mailto:info.prismpackworld@gmail.com" class="hover:text-foreground transition-colors">info.prismpackworld@gmail.com</a>
      </address>
      <a href="/contact" class="inline-block mt-5 text-sm font-display font-semibold tracking-wide text-accent hover:text-accent/80 transition-colors underline underline-offset-4">
        Request a Quote →
      </a>
    </div>
  </div>

  <div class="border-t border-border/60">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-5 flex items-center justify-center text-xs text-muted-foreground">
      <span>© 2026 Prism Packworld. All rights reserved.</span>
    </div>
  </div>
</footer>
