---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero-home.jpg';
import { products } from '../data/products';
import ProductCard from '../components/ProductCard.astro';
import SectionHeader from '../components/SectionHeader.astro';

const industries = [
  { name: 'Luxury Goods', description: 'High packaging solutions in cosmetics and niche luxury goods.', icon: 'award' },
  { name: 'E-Commerce', description: 'Prism Packworld delivers sophisticated, custom-crafted packaging for e-commerce.', icon: 'package' },
  { name: 'Food & Beverage', description: 'High packaging solutions in laboratories, food & beverage sectors.', icon: 'shield' },
  { name: 'Pharmaceuticals', description: 'Promoting solutions in cosmetics, sustainability, and pharmaceuticals.', icon: 'leaf' },
];
---

<Layout title="Prism Packworld — Premium Packaging Solutions">
  <Header />
  
  <main class="flex-1 pt-16">
    <!-- Hero Section -->
    <section class="relative min-h-[92vh] flex items-center overflow-hidden bg-background">
      <div class="absolute inset-0 z-0">
        <img 
          src={heroImg.src} 
          alt="Premium packaging collection" 
          class="w-full h-full object-cover object-center opacity-20" 
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-background via-background/80 to-background/30"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full py-24">
        <div class="max-w-2xl animate-fade-in-up">
          <span class="inline-flex items-center justify-center rounded-md border border-accent/40 text-accent font-display text-xs tracking-widest uppercase px-3 py-1 mb-6">

            Premium Packaging Solutions
          </span>
          <h1 class="font-display font-extrabold text-5xl md:text-6xl lg:text-7xl leading-[0.95] tracking-tight text-foreground mb-6">
            Elevate Your Product Presentation
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed mb-10 max-w-lg">
            Prism Packworld delivers sophisticated, custom-crafted packaging tailored for professional industries. Explore our high-quality solutions across various categories.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="#products" class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md bg-foreground text-background hover:bg-accent hover:text-foreground font-display font-semibold tracking-wide text-base transition-smooth">
              Explore Solutions
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
            <a href="/contact" class="inline-flex items-center justify-center h-12 px-8 rounded-md border border-border bg-background hover:bg-accent hover:text-accent-foreground hover:border-foreground font-display font-semibold tracking-wide text-base transition-smooth">
              Request a Quote
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Products Grid -->
    <section id="products" class="bg-muted/30 py-24 scroll-mt-16">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <SectionHeader 
          eyebrow="Our Portfolio" 
          title="Packaging Solutions" 
          description="Six distinct product categories, each engineered for performance and crafted for lasting brand impression." 
        />

        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in-up" style="animation-delay: 200ms;">
          {products.map((product) => (

            <ProductCard product={product} />
          ))}
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="bg-background py-24 scroll-mt-16">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="font-display text-xs tracking-widest uppercase text-accent mb-3">About Us</p>
          <h2 class="font-display font-extrabold text-4xl md:text-5xl text-foreground tracking-tight mb-6">Precision. Craft. Presence.</h2>
          <p class="text-muted-foreground leading-relaxed mb-5">
            Prism Packworld has been a trusted partner for brands that understand packaging is not a commodity — it is an extension of their identity. Every solution we produce is engineered to precise specifications and finished with obsessive attention to detail.
          </p>
          <p class="text-muted-foreground leading-relaxed mb-8">
            Our manufacturing facilities combine modern offset printing with traditional craft techniques — the result is packaging that performs in transit and commands attention on shelf.
          </p>
          <div class="flex justify-center">
            <div class="text-center">
              <p class="font-display font-extrabold text-3xl text-foreground">1,200+</p>
              <p class="text-xs text-muted-foreground mt-1">Clients Served</p>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-square rounded-2xl overflow-hidden bg-muted/40">
            <img 
              src={heroImg.src} 
              alt="Premium packaging collection" 
              class="w-full h-full object-cover" 
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-4 -left-4 bg-card border border-border rounded-xl px-6 py-4 shadow-elevated">
            <p class="font-display font-bold text-2xl text-foreground">FSC®</p>
            <p class="text-xs text-muted-foreground">Certified Materials</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Industry Focus -->
    <section class="bg-muted/30 py-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <SectionHeader 
          eyebrow="Industry Focus" 
          title="Applicable across industry sectors" 
          centered={true}
        />

        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {industries.map((industry) => (
            <div class="bg-card rounded-xl p-7 border border-border shadow-card hover:shadow-elevated transition-smooth group">
              <div class="w-10 h-10 rounded-lg bg-muted/60 flex items-center justify-center mb-5 group-hover:bg-accent/10 transition-colors">
                {industry.icon === 'award' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg>}
                {industry.icon === 'package' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg>}
                {industry.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>}
                {industry.icon === 'leaf' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>}
              </div>
              <h3 class="font-display font-bold text-base text-foreground mb-2">{industry.name}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{industry.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="bg-foreground py-20">
      <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
        <h2 class="font-display font-extrabold text-4xl md:text-5xl text-background tracking-tight mb-5">Ready to elevate your packaging?</h2>
        <p class="text-background/70 mb-10 max-w-xl mx-auto">Contact our team and receive a tailored quote for your project within 24 hours.</p>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 h-12 px-10 rounded-md bg-accent text-foreground hover:bg-accent/80 font-display font-bold text-base tracking-wide transition-smooth">
          Get a Custom Quote
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
