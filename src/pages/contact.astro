---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Request a Custom Quote — Prism Packworld">
  <Header />
  
  <main class="flex-1 pt-16">
    <section class="bg-background py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-16">
          <p class="font-display text-xs tracking-widest uppercase text-accent mb-3">Get in Touch</p>
          <h1 class="font-display font-extrabold text-5xl md:text-6xl text-foreground tracking-tight mb-6">Request a Custom Quote</h1>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Tell us about your project and we'll get back to you within 24 hours with a tailored proposal.
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-12">
          <!-- Contact Form -->
          <div class="lg:col-span-2 bg-card rounded-2xl border border-border p-8 shadow-card">
            <form class="grid sm:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label for="name" class="text-sm font-medium text-foreground">Full Name <span class="text-accent">*</span></label>
                <input type="text" id="name" placeholder="Jane Smith" class="h-12 px-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth" required />
              </div>
              <div class="flex flex-col gap-2">
                <label for="company" class="text-sm font-medium text-foreground">Company</label>
                <input type="text" id="company" placeholder="Acme Corp" class="h-12 px-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth" />
              </div>
              <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-medium text-foreground">Email Address <span class="text-accent">*</span></label>
                <input type="email" id="email" placeholder="jane@company.com" class="h-12 px-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth" required />
              </div>
              <div class="flex flex-col gap-2">
                <label for="phone" class="text-sm font-medium text-foreground">Phone Number</label>
                <input type="tel" id="phone" placeholder="+1 234 567 890" class="h-12 px-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth" />
              </div>
              <div class="flex flex-col gap-2">
                <label for="category" class="text-sm font-medium text-foreground">Product Category <span class="text-accent">*</span></label>
                <select id="category" class="h-12 px-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth" required>
                  <option value="" disabled selected>Select a category</option>
                  <option value="rigid-box">Rigid Boxes</option>
                  <option value="corrugated-box">Corrugated Boxes</option>
                  <option value="mono-carton">Mono Cartons</option>
                  <option value="paper-tube">Paper Tubes</option>
                  <option value="paper-bag">Paper Bags</option>
                  <option value="tags">Tags & Labels</option>
                </select>
              </div>
              <div class="flex flex-col gap-2">
                <label for="enquiry" class="text-sm font-medium text-foreground">Enquiry Type <span class="text-accent">*</span></label>
                <select id="enquiry" class="h-12 px-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth" required>
                  <option value="" disabled selected>Select type</option>
                  <option value="new-project">New Project</option>
                  <option value="reorder">Reorder</option>
                  <option value="sampling">Sampling</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="sm:col-span-2 flex flex-col gap-2">
                <label for="details" class="text-sm font-medium text-foreground">Project Details <span class="text-accent">*</span></label>
                <textarea id="details" rows="4" placeholder="Tell us about your product, dimensions, finish requirements, timeline..." class="p-4 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-smooth resize-none" required></textarea>
              </div>
              <div class="sm:col-span-2 mt-4">
                <button type="submit" class="w-full h-14 rounded-xl bg-foreground text-background hover:bg-accent hover:text-foreground font-display font-bold text-lg tracking-wide transition-smooth shadow-card">
                  Send Enquiry
                </button>
              </div>
            </form>
          </div>

          <!-- Contact Info Sidebar -->
          <div class="flex flex-col gap-8">
            <div class="bg-card rounded-2xl border border-border p-8 shadow-card">
              <h3 class="font-display font-bold text-xl text-foreground mb-6">Contact Information</h3>
              <div class="flex flex-col gap-6">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-muted/60 flex items-center justify-center flex-shrink-0 text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  </div>
                  <div>
                    <p class="text-xs font-display font-semibold tracking-widest uppercase text-muted-foreground mb-1">Phone</p>
                    <p class="text-foreground font-medium">9909927668</p>
                  </div>
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-muted/60 flex items-center justify-center flex-shrink-0 text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                  </div>
                  <div>
                    <p class="text-xs font-display font-semibold tracking-widest uppercase text-muted-foreground mb-1">Email</p>
                    <p class="text-foreground font-medium">info.prismpackworld@gmail.com</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-muted/40 rounded-2xl border border-border p-8">
              <h3 class="font-display font-bold text-lg text-foreground mb-3">Quick turnaround</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">
                All enquiries are reviewed by our team within one business day. Samples can be arranged for approved projects.
              </p>
            </div>

            <div class="bg-card rounded-2xl border border-border p-8 shadow-card">
              <h3 class="font-display font-bold text-lg text-foreground mb-4">Explore our range</h3>
              <a href="/#products" class="text-sm font-display font-semibold text-accent hover:text-accent/80 transition-colors flex items-center gap-2">
                ← View all packaging solutions
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
